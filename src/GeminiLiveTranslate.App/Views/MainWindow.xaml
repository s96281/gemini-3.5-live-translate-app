<Window x:Class="GeminiLiveTranslate.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GeminiLiveTranslate.App.Controls"
        Title="Gemini 3.5 Live Translate — Windows 11 Fluent 2 Console"
        Width="1040" Height="740"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        Foreground="#F8FAFC"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="FluentToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource FluentToolbarButtonStyle}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40334155"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootDashboardGrid" Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Fluent 2 Header & Quick Action Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Audio Source Switcher & Language Selector -->
            <RowDefinition Height="Auto"/> <!-- Row 2: 36-Band Dynamic Audio Spectrum Waveform & Live Stream Preview -->
            <RowDefinition Height="*"/>    <!-- Row 3: Virtualized Bilingual Translation History Card Stream -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header Bar -->
        <Border Grid.Row="0"
                CornerRadius="12"
                Background="#2C2C2C"
                BorderBrush="#40475569"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title & Connection Status Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#2000E5FF" Margin="0,0,12,0">
                        <TextBlock Text="&#xE720;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#00E5FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gemini 3.5 Live 雙語同聲傳譯控制台"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="8" Height="8" Fill="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnectionStatusTextBlock"
                                       Text="{Binding StatusText}"
                                       FontSize="12"
                                       Foreground="#38BDF8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons: Overlay Toggle, Click-Through, Theme, Settings, Start/Stop -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleOverlayButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ToggleOverlayCommand}"
                            ToolTip="顯示/隱藏桌面歌詞懸浮條 (Floating Overlay Window)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="桌面歌詞懸浮條" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToggleClickThroughButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ToggleOverlayClickThroughCommand}"
                            ToolTip="一鍵切換懸浮窗滑鼠穿透鎖定 (全域熱鍵 Ctrl+F8)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="穿透鎖定 (Ctrl+F8)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToggleThemeButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="切換深色/淺色 Fluent 2 主題 (Dark / Light Theme)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE793;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Theme}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenSettingsButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Click="OnOpenSettingsClick"
                            ToolTip="開啟應用程式設定對話框 (API Key / 模型 / 音色 / 段落長度上限)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="設定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SessionToggleButton"
                            Style="{StaticResource FluentPrimaryActionStyle}"
                            Command="{Binding ToggleSessionCommand}"
                            Content="{Binding SessionActionButtonText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Audio Source Quick Switcher & Target Language Bar -->
        <Border Grid.Row="1"
                CornerRadius="12"
                Background="#2C2C2C"
                BorderBrush="#40475569"
                BorderThickness="1"
                Padding="16,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Audio Source Quick Switcher: System Audio Loopback vs Physical Microphone -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="音訊來源切換:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <RadioButton x:Name="SystemLoopbackRadioButton"
                                 GroupName="AudioSourceGroup"
                                 Content="系統音效內錄 (System Audio Loopback)"
                                 Foreground="#F8FAFC"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0"
                                 IsChecked="{Binding IsSystemAudioLoopback, Mode=TwoWay}"/>

                    <RadioButton x:Name="MicrophoneRadioButton"
                                 GroupName="AudioSourceGroup"
                                 Content="實體麥克風 (Microphone)"
                                 Foreground="#F8FAFC"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding IsMicrophoneSource, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Acoustic Feedback Protection Status Pill -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        Margin="16,0"
                        CornerRadius="6"
                        Background="#250284C7"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding AudioSourceStatusText}"
                               FontSize="11"
                               Foreground="#38BDF8"/>
                </Border>

                <!-- Target Language Selector (70+ Supported Languages) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目標翻譯語言:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="TargetLanguageComboBox"
                              Width="220"
                              Height="30"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Real-Time 36-Band Audio Spectrum Waveform Visualizer & Live Stream Preview -->
        <Border Grid.Row="2"
                CornerRadius="12"
                Background="#2C2C2C"
                BorderBrush="#40475569"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="即時音訊頻譜波形 (36-Band Dynamic FFT Spectrum · 16kHz Mono PCM)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               Text="{Binding CurrentRmsLevel, StringFormat='RMS 音量: {0:P0}'}"
                               FontSize="11"
                               Foreground="#94A3B8"/>
                </Grid>

                <!-- 36-Band Custom Hardware-Accelerated Spectrum Visualizer -->
                <controls:SpectrumVisualizer x:Name="AudioSpectrumVisualizer"
                                             Grid.Row="1"
                                             Height="68"
                                             IsActive="{Binding IsSessionActive}"
                                             RmsLevel="{Binding CurrentRmsLevel}"/>

                <!-- Live Streaming Transcript Preview -->
                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        CornerRadius="8"
                        Background="#400F172A"
                        Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentSourceTranscript}"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentTargetTranscript}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#00E5FF"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 3: Bilingual Translation History Card Stream (Virtualized) -->
        <Border Grid.Row="3"
                CornerRadius="12"
                Background="#2C2C2C"
                BorderBrush="#40475569"
                BorderThickness="1"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- History Section Header & Clear Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="雙語即時翻譯歷史紀錄串流 (Bilingual Translation History)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Button x:Name="ClearHistoryButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ClearHistoryCommand}"
                            Content="清除紀錄 (Clear)"/>
                </Grid>

                <!-- Virtualized Card Stream -->
                <ScrollViewer x:Name="HistoryScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl x:Name="HistoryItemsControl"
                                  ItemsSource="{Binding HistoryCards}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  VirtualizingStackPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsVirtualizing="True"
                                                        VirtualizationMode="Recycling"
                                                        ScrollUnit="Pixel"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,0,8"
                                        Background="#601E293B"
                                        BorderBrush="#40334155"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header: Timestamp, Target Language Pill & Copy Button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                                <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,1" Background="#300284C7">
                                                    <TextBlock Text="{Binding TargetLanguage}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>

                                            <Button HorizontalAlignment="Right"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    Command="{Binding DataContext.CopyTurnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnCopyTurnClick"
                                                    ToolTip="複製此段雙語紀錄">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="複製" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Source Original Transcription -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SourceText}"
                                                   Foreground="#94A3B8"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>

                                        <!-- Target Translated Text -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding TargetText}"
                                                   Foreground="#F8FAFC"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
