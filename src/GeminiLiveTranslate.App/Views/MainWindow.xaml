<Window x:Class="GeminiLiveTranslate.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GeminiLiveTranslate.App.Controls"
        Title="Gemini 3.5 Live 即時口譯控制台"
        Width="1060" Height="760"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#0A0D14"
        Foreground="#F8FAFC"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Modern Obsidian Dark ComboBox Toggle Button -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="true">
                <Border x:Name="splitBorder"
                        Width="28"
                        HorizontalAlignment="Right"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        SnapsToDevicePixels="true">
                    <Path x:Name="arrow"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#94A3B8"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00E5FF"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00E5FF"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#00E5FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Obsidian Dark ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252D42"/>
                                <Setter Property="Foreground" Value="#00F2FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Obsidian Dark ComboBox Style -->
        <Style x:Key="ModernDarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#141824"/>
            <Setter Property="BorderBrush" Value="#2A344A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource DarkComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Margin="12,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="false"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#161B28"
                                        BorderBrush="#2A344A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true" Margin="2,4">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="MinHeight" Value="50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Obsidian Toolbar Button Style -->
        <Style x:Key="FluentToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181E2E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#252D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252E44"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Pill RadioButton Style -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#20334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Start/Stop Button Style -->
        <Style x:Key="HeroSessionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="heroBorder"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0.0"/>
                                    <GradientStop Color="#0369A1" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                <Setter TargetName="heroBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EF4444" Offset="0.0"/>
                                            <GradientStop Color="#B91C1C" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="heroBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="heroBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Icon Button Style -->
        <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252D42"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootDashboardGrid" Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top Header & Action Controls -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Audio Source Segmented Pill & Target Language -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Dynamic Spectrum Waveform & Live Streaming Card -->
            <RowDefinition Height="*"/>    <!-- Row 3: Bilingual Translation History Card Stream -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header Bar -->
        <Border Grid.Row="0"
                CornerRadius="14"
                Background="#121622"
                BorderBrush="#252D44"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title & Live Connection Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1E00E5FF" Margin="0,0,12,0">
                        <TextBlock Text="&#xE720;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#00E5FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gemini 3.5 Live 即時口譯控制台"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#00E5FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="ConnectionStatusTextBlock"
                                       Text="{Binding StatusText}"
                                       FontSize="12"
                                       Foreground="#38BDF8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Action Toolbar: Overlay Toggle, Click-Through, Theme, Settings, Hero Session Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleOverlayButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ToggleOverlayCommand}"
                            ToolTip="顯示或隱藏桌面懸浮字幕視窗">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="懸浮字幕" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToggleClickThroughButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ToggleOverlayClickThroughCommand}"
                            ToolTip="切換懸浮字幕滑鼠穿透鎖定 (熱鍵 Ctrl+F8)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="穿透鎖定 (Ctrl+F8)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToggleThemeButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="切換介面深色/淺色主題">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE793;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Theme}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenSettingsButton"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Click="OnOpenSettingsClick"
                            ToolTip="開啟應用程式引擎設定">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="設定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SessionToggleButton"
                            Style="{StaticResource HeroSessionButtonStyle}"
                            Command="{Binding ToggleSessionCommand}"
                            Content="{Binding SessionActionButtonText}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Audio Source Segmented Pill Switcher & Target Language Bar -->
        <Border Grid.Row="1"
                CornerRadius="14"
                Background="#121622"
                BorderBrush="#252D44"
                BorderThickness="1"
                Padding="16,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Audio Source Segmented Pill Capsule -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="音訊來源:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Border Background="#0C0F17" BorderBrush="#252D42" BorderThickness="1" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SystemLoopbackRadioButton"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         GroupName="AudioSourceSegment"
                                         Content="🔊 系統音效內錄"
                                         IsChecked="{Binding IsSystemAudioLoopback, Mode=TwoWay}"/>
                            <RadioButton x:Name="MicrophoneRadioButton"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         GroupName="AudioSourceSegment"
                                         Content="🎙 實體麥克風"
                                         IsChecked="{Binding IsMicrophoneSource, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Acoustic Feedback Protection Pill Status -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        Margin="18,0"
                        CornerRadius="6"
                        Background="#1A0284C7"
                        BorderBrush="#300284C7"
                        BorderThickness="1"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding AudioSourceStatusText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#38BDF8"/>
                </Border>

                <!-- Target Language Dark ComboBox -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目標語言:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="TargetLanguageComboBox"
                              Width="230"
                              Height="34"
                              Style="{StaticResource ModernDarkComboBoxStyle}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: 36-Band Dynamic Spectrum Visualizer & Real-Time Live Streaming Card -->
        <Border Grid.Row="2"
                CornerRadius="14"
                Background="#121622"
                BorderBrush="#252D44"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="即時音訊頻譜波形 (16kHz Mono Linear PCM)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               Text="{Binding CurrentRmsLevel, StringFormat='RMS 音量: {0:P0}'}"
                               FontSize="11"
                               Foreground="#94A3B8"/>
                </Grid>

                <!-- 36-Band Spectrum Visualizer -->
                <controls:SpectrumVisualizer x:Name="AudioSpectrumVisualizer"
                                             Grid.Row="1"
                                             Height="60"
                                             IsActive="{Binding IsSessionActive}"
                                             RmsLevel="{Binding CurrentRmsLevel}"/>

                <!-- Real-Time Live Streaming Card -->
                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        CornerRadius="10"
                        Background="#0D111A"
                        BorderBrush="#252D42"
                        BorderThickness="1"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Live Status Indicator -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                                    <Setter Property="Fill" Value="#00F2FE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="待命中 · 點擊右上角「開始口譯」啟動即時雙語翻譯"/>
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                                    <Setter Property="Text" Value="即時串流口譯中..."/>
                                                    <Setter Property="Foreground" Value="#00F2FE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Live Source Transcript -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding CurrentSourceTranscript}"
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,4"/>

                        <!-- Live Target Translation -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CurrentTargetTranscript}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#00F2FE"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Row 3: Bilingual Translation History Card Stream (Virtualized) -->
        <Border Grid.Row="3"
                CornerRadius="14"
                Background="#121622"
                BorderBrush="#252D44"
                BorderThickness="1"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- History Section Header & Clear Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="雙語翻譯歷史紀錄"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Button x:Name="ClearHistoryButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource FluentToolbarButtonStyle}"
                            Command="{Binding ClearHistoryCommand}"
                            Content="清除紀錄"/>
                </Grid>

                <!-- Virtualized Card Stream -->
                <ScrollViewer x:Name="HistoryScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl x:Name="HistoryItemsControl"
                                  ItemsSource="{Binding HistoryCards}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  VirtualizingStackPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsVirtualizing="True"
                                                        VirtualizationMode="Recycling"
                                                        ScrollUnit="Pixel"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,0,8"
                                        Background="#161B28"
                                        BorderBrush="#252D42"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header: Timestamp, Target Language Pill & Copy Button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                                <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,1" Background="#250284C7">
                                                    <TextBlock Text="{Binding TargetLanguage}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>

                                            <Button HorizontalAlignment="Right"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    Command="{Binding DataContext.CopyTurnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnCopyTurnClick"
                                                    ToolTip="複製此段雙語紀錄">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="複製" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Source Original Transcription -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SourceText}"
                                                   Foreground="#94A3B8"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>

                                        <!-- Target Translated Text -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding TargetText}"
                                                   Foreground="#F8FAFC"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
