<Window x:Class="GeminiLiveTranslate.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini 翻譯引擎設定"
        Width="540" Height="640"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E121A"
        Foreground="#F8FAFC"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Modern Obsidian Dark ComboBox Toggle Button -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="true">
                <Border x:Name="splitBorder"
                        Width="30"
                        HorizontalAlignment="Right"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        SnapsToDevicePixels="true">
                    <Path x:Name="arrow"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#94A3B8"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00E5FF"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00E5FF"/>
                    <Setter TargetName="arrow" Property="Fill" Value="#00E5FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern Obsidian Dark ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252D42"/>
                                <Setter Property="Foreground" Value="#00F2FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Obsidian Dark ComboBox Style -->
        <Style x:Key="ModernDarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#141824"/>
            <Setter Property="BorderBrush" Value="#2A344A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource DarkComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Margin="12,0,32,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="false"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#161B28"
                                        BorderBrush="#2A344A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true" Margin="2,4">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="MinHeight" Value="50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="FluentPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252D42"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="14" Background="#121622" BorderBrush="#252D44" BorderThickness="1" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="38" Height="38" CornerRadius="10" Background="#1E00E5FF" Margin="0,0,12,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gemini Live 翻譯引擎設定" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Windows DPAPI 硬體加密保護您的憑證安全" FontSize="11" Foreground="#38BDF8"/>
                </StackPanel>
            </StackPanel>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 1. Google AI Studio API Key -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Google AI Studio API 金鑰"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Grid.Column="0"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Background="#161B28"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#2A344A"
                                     BorderThickness="1"
                                     Padding="10,4"
                                     PasswordChanged="OnApiKeyPasswordChanged"/>

                        <TextBox x:Name="ApiKeyTextBox"
                                 Grid.Column="0"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Background="#161B28"
                                 Foreground="#F8FAFC"
                                 BorderBrush="#2A344A"
                                 BorderThickness="1"
                                 Padding="10,4"
                                 Visibility="Collapsed"
                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button x:Name="ToggleRevealButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Click="OnToggleRevealApiKeyClick"
                                ToolTip="顯示或隱藏 API Key">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="金鑰遮罩預覽: " FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding MaskedApiKey}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>

                    <!-- 2. Gemini Live Model Selection -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Gemini 翻譯模型"/>
                    <ComboBox x:Name="ModelComboBox"
                              Height="36"
                              Style="{StaticResource ModernDarkComboBoxStyle}"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="支援 Gemini 2.0 Flash / 2.5 Flash / 3.5 Live 雙向低延遲串流模型"/>

                    <!-- 3. Voice Selection -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="語音合成音色"/>
                    <ComboBox x:Name="VoiceComboBox"
                              Height="36"
                              Style="{StaticResource ModernDarkComboBoxStyle}"
                              ItemsSource="{Binding AvailableVoices}"
                              SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"/>

                    <!-- 4. Paragraph Character Hard-Cut Threshold -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="字幕單段長度上限"/>
                    <ComboBox x:Name="ParagraphLengthComboBox"
                              Height="36"
                              Style="{StaticResource ModernDarkComboBoxStyle}"
                              ItemsSource="{Binding SupportedParagraphLengths}"
                              SelectedItem="{Binding SelectedParagraphLength, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="依字數上限 (35 / 50 / 75 / 100 字) 與 4 階標點符號優先級強制自動分段"/>

                    <!-- 5. Theme Selection -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="介面外觀主題"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Height="36"
                              Style="{StaticResource ModernDarkComboBoxStyle}"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>

                    <!-- 6. Auto-Play TTS Switch -->
                    <CheckBox x:Name="AutoPlayAudioCheckBox"
                              Margin="0,16,0,8"
                              Foreground="#F1F5F9"
                              FontSize="13"
                              IsChecked="{Binding AutoPlayAudio, Mode=TwoWay}"
                              Content="自動播放翻譯語音 · 系統內錄模式下自動靜音防回授"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Dialog Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Content="取消"
                        Margin="0,0,10,0"
                        Click="OnCancelClick"/>
                <Button x:Name="SaveButton"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Content="儲存設定"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
