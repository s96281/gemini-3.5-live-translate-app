<Window x:Class="GeminiLiveTranslate.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="應用程式設定 (Application Settings)"
        Width="540" Height="620"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#202020"
        Foreground="#F8FAFC"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="FluentPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="12" Background="#2C2C2C" BorderBrush="#40475569" BorderThickness="1" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Gemini Live 翻譯引擎設定" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Windows DPAPI 硬體綁定加密保護您的憑證安全" FontSize="11" Foreground="#38BDF8"/>
                </StackPanel>
            </StackPanel>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 1. Google AI Studio API Key -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Google AI Studio API Key"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Grid.Column="0"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Background="#1E293B"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#475569"
                                     Padding="8,4"
                                     PasswordChanged="OnApiKeyPasswordChanged"/>

                        <TextBox x:Name="ApiKeyTextBox"
                                 Grid.Column="0"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Background="#1E293B"
                                 Foreground="#F8FAFC"
                                 BorderBrush="#475569"
                                 Padding="8,4"
                                 Visibility="Collapsed"
                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button x:Name="ToggleRevealButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Click="OnToggleRevealApiKeyClick"
                                ToolTip="顯示/隱藏 API Key">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="遮罩預覽: " FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding MaskedApiKey}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>

                    <!-- 2. Gemini Live Model Selection -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Gemini Live 模型選擇 (Model)"/>
                    <ComboBox x:Name="ModelComboBox"
                              Height="34"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="支援 Gemini 2.0 Flash / 2.5 Flash / 3.5 Live 雙向低延遲串流模型"/>

                    <!-- 3. Voice Selection -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="語音合成音色 (Voice)"/>
                    <ComboBox x:Name="VoiceComboBox"
                              Height="34"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableVoices}"
                              SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"/>

                    <!-- 4. Paragraph Character Hard-Cut Threshold -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="字幕段落長度硬切割上限 (Max Paragraph Characters)"/>
                    <ComboBox x:Name="ParagraphLengthComboBox"
                              Height="34"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding SupportedParagraphLengths}"
                              SelectedItem="{Binding SelectedParagraphLength, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="依字數上限 (35 / 50 / 75 / 100 字) 與 4 階標點符號優先級強制自動分段"/>

                    <!-- 5. Theme Selection -->
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="介面主題外觀 (Fluent 2 Theme)"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Height="34"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>

                    <!-- 6. Auto-Play TTS Switch -->
                    <CheckBox x:Name="AutoPlayAudioCheckBox"
                              Margin="0,16,0,8"
                              Foreground="#F1F5F9"
                              FontSize="13"
                              IsChecked="{Binding AutoPlayAudio, Mode=TwoWay}"
                              Content="自動播放翻譯語音 (Auto-play TTS Audio · 系統內錄模式下自動靜音防回授)"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Dialog Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Content="取消 (Cancel)"
                        Margin="0,0,10,0"
                        Click="OnCancelClick"/>
                <Button x:Name="SaveButton"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Content="儲存設定 (Save)"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
