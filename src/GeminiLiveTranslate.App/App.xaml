<Application x:Class="GeminiLiveTranslate.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Windows 11 Fluent Design 2 Global Color Tokens & Typography -->
        <SolidColorBrush x:Key="FluentDarkBackgroundBrush" Color="#202020"/>
        <SolidColorBrush x:Key="FluentDarkCardBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="FluentLightBackgroundBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="FluentLightCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FluentAccentCyanBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="FluentAccentPurpleBrush" Color="#A855F7"/>
        <FontFamily x:Key="FluentIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="FluentBodyFontFamily">Segoe UI Variable Display, Microsoft JhengHei, Segoe UI, sans-serif</FontFamily>
    </Application.Resources>
</Application>
